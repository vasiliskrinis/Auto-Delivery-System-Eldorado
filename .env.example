# ── Eldorado ─────────────────────────────────────────────────────────────────
ELDORADO_EMAIL=your@email.com
ELDORADO_PASSWORD=yourpassword

# Optional: paste your Eldorado browser session cookies as a JSON string to
# skip the login step in Playwright mode (speeds up startup).
# Get them from DevTools → Application → Cookies → eldorado.gg
# Example: [{"name":"session","value":"abc123","domain":"eldorado.gg"}]
ELDORADO_COOKIES=

# ── Roblox ───────────────────────────────────────────────────────────────────
# Your .ROBLOSECURITY cookie (from browser DevTools after logging into Roblox).
# WARNING: Sharing or leaking this allows full account access. Keep it private.
ROBLOSECURITY=_|WARNING:-DO-NOT-SHARE-THIS.--Sharing-this-will-allow-someone-to-log-in-as-you-and-to-steal-your-ROBUX-and-items.|

# ── ADB / Waydroid ───────────────────────────────────────────────────────────
# ADB device serial (leave blank if only one device/emulator is connected).
# Run 'adb devices' to find the serial of your Waydroid instance.
ADB_DEVICE_SERIAL=

# ── Timing ───────────────────────────────────────────────────────────────────
# How often to check Eldorado for new orders (milliseconds).
# Keep at 45000 or higher to avoid looking like a scraper.
POLL_INTERVAL_MS=45000

# How long to wait for the in-game mail animation / confirmation (milliseconds)
MAIL_SEND_WAIT_MS=4000

# ── Discord bot ──────────────────────────────────────────────────────────────
# Leave all DISCORD_* blank to run without the Discord bot.
#
# How to set up:
#   1. Go to https://discord.com/developers/applications → New Application
#   2. Under Bot: create a bot, copy the Token → DISCORD_TOKEN
#   3. Under OAuth2 → General: copy Application ID → DISCORD_CLIENT_ID
#   4. Add the bot to your server with scopes: bot + applications.commands
#      Permissions needed: Send Messages, Embed Links
#   5. Right-click your notification channel → Copy Channel ID → DISCORD_CHANNEL_ID
#   6. Right-click your server → Copy Server ID → DISCORD_GUILD_ID
#   7. Run: npm run register:discord   (one time, to register slash commands)

DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# ── Testing ───────────────────────────────────────────────────────────────────
# Set to true to skip all ADB taps and Eldorado API calls (safe for testing).
# Used automatically by: npm run test:order  and  npm run start:dry
DRY_RUN=false

# ── Misc ─────────────────────────────────────────────────────────────────────
STATE_FILE_PATH=./data/state.json
LOG_LEVEL=info
